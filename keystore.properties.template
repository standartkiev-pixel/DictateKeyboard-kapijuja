# Kapijuja Voice release signing credentials.
#
# Copy this file to `keystore.properties` in the repository root and fill in the real values.
# `keystore.properties` is gitignored and must NEVER be committed.
#
# Kapijuja Voice has its own Android identity: net.kapijuja.voice.
# Every future release must be signed with the SAME release key so Android can update it in place.
#
# storeFile is resolved relative to the repository root. Keep the .jks/.keystore outside version
# control (the repository .gitignore already excludes *.jks / *.keystore).

storeFile=../path/to/kapijuja-voice-release.jks
storePassword=CHANGEME
keyAlias=kapijuja_voice_release
keyPassword=CHANGEME
