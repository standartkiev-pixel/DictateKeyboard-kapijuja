    <string name="dictate__floating_button_retry_hint">%1$s — pieskaries, lai mēģinātu vēlreiz</string>
    <string name="dictate__haptic_feedback_title">Haptiskā atsauce</string>
    <string name="dictate__haptic_feedback_summary">Vibrē, sākot vai apturot ierakstu, kad transkripcija ir gatava un veicot pārformulēšanu.</string>
    <string name="dictate__audio_source_voice_communication">Balss saziņa</string>
    <string name="dictate__audio_source_voice_communication_summary">Augstākā mikrofona prioritāte — darbojas, kad citā lietotnē tiek izmantots mikrofons, taču var samazināt precizitāti.</string>
    <string name="about__whats_new__title">Jaunumi</string>
    <string name="about__whats_new__versioned">Jaunumi {version} versijā</string>
    <string name="about__whats_new__summary">Skatīt funkciju tūri vēlreiz</string>
    <string name="apptour__skip">Izlaist</string>
    <string name="apptour__next">Tālāk</string>
    <string name="apptour__start">Sākam</string>
    <string name="apptour__done">Gatavs</string>
    <string name="apptour__badge_highlight">★ Izceļams</string>
    <string name="apptour__intro_eyebrow">Version 5.0</string>
    <string name="apptour__intro_title">Ātra tūre</string>
    <string name="apptour__intro_body">Lūk, kas jauns programmā Dictate 5.0 — svarīgākais mazāk nekā minūtē. Pieskaries «Izmēģināt» jebkurā lapā, lai uzreiz pārietu uz attiecīgo iestatījumu.</string>
    <string name="apptour__glide_eyebrow">Tastatūra</string>
    <string name="apptour__glide_title">Velc, lai rakstītu</string>
    <string name="apptour__glide_body">Slidini pirkstu no taustiņa uz taustiņu, un Dictate pārvērš šo ceļu par veseliem vārdiem. Katrai valodai ir sava vārdnīca, ko lejupielādē pēc pieprasījuma — ieslēdz to sadaļā Žesti.</string>
    <string name="apptour__glide_cta">Iestatīt vilkšanas rakstīšanu</string>
    <string name="apptour__suggestions_eyebrow">Tastatūra</string>
    <string name="apptour__suggestions_title">Automātiskā labošana un ieteikumi</string>
    <string name="apptour__suggestions_body">Kamēr raksti, Dictate iesaka piemērotus vārdus un klusi izlabo drukas kļūdas. Vārds, ko patiešām ievadīji, paliek ieteikumu joslā, tāpēc viens pieskāriens atceļ jebkuru labojumu.</string>
    <string name="apptour__suggestions_cta">Pielāgot ieteikumus</string>
    <string name="apptour__realtime_eyebrow">Transkripcija</string>
    <string name="apptour__realtime_title">Reāllaika transkripcija</string>
    <string name="apptour__realtime_body">Vēro, kā tavi vārdi parādās tiešraidē, kamēr vēl runā, negaidot ieraksta beigas. Darbojas ar OpenAI, Deepgram, Soniox, AssemblyAI un ElevenLabs.</string>
    <string name="apptour__realtime_cta">Ieslēgt reāllaiku</string>
    <string name="apptour__providers_eyebrow">Transkripcija</string>
    <string name="apptour__providers_title">Trīs jauni mākoņa pakalpojumi</string>
    <string name="apptour__providers_body">ElevenLabs Scribe, Deepgram un AssemblyAI pievienojas transkripcijas pakalpojumiem — izvēlies to, kas vislabāk atbilst tavai valodai, precizitātei, ātrumam un budžetam.</string>
    <string name="apptour__providers_cta">Izvēlēties pakalpojumu</string>
    <string name="apptour__legacy_eyebrow">Klasika atgriežas</string>
    <string name="apptour__legacy_title">Klasiskais diktēšanas izkārtojums</string>
    <string name="apptour__legacy_body">Dod priekšroku balsij, nevis taustiņiem? Dictate 3 ekrāns bez tastatūras ir atgriezies — padari to par noklusējumu vai turi to tikai vienu vilkšanu attālumā no pilnās tastatūras.</string>
    <string name="apptour__legacy_cta">Izvēlēties izkārtojumu</string>
    <string name="apptour__library_eyebrow">Kopiena</string>
    <string name="apptour__library_title">Uzvednu bibliotēka</string>
    <string name="apptour__library_body">Pārlūko kopienas kopīgotās pārfrāzēšanas uzvednes un instalē tās ar vienu pieskārienu — vai publicē savas, lai tās izmantotu citi.</string>
    <string name="apptour__library_cta">Atvērt bibliotēku</string>
    <string name="apptour__stats_eyebrow">Ieskati</string>
    <string name="apptour__stats_title">Tavas diktēšanas statistika</string>
    <string name="apptour__stats_body">Seko līdzi, cik daudz laika gaitā esi diktējis un rakstījis, sasniedz atskaites punktus un skati ātru kopsavilkumu tieši sākuma ekrānā.</string>
    <string name="apptour__stats_cta">Skatīt statistiku</string>
    <string name="apptour__offline_eyebrow">Bez mākoņa</string>
    <string name="apptour__offline_title">Transkribē bezsaistē</string>
    <string name="apptour__offline_body">Palaid NVIDIA Parakeet modeli pilnībā savā tālrunī — bez interneta, nekas neatstāj ierīci. Klusuma filtrs arī izlaiž tukšos ierakstus, tāpēc nekad nesaņem lieku tekstu.</string>
    <string name="apptour__offline_cta">Iegūt bezsaistes modeli</string>
    <string name="apptour__outro_eyebrow">Un vēl</string>
    <string name="apptour__outro_title">Noslīpēts visur</string>
    <string name="apptour__outro_body">Vēl kas zem pārsega: stabilāka peldoša poga, spriešanas intensitātes vadība pārfrāzēšanai, taktilā atsauce, jauna E-Reader tēma un desmitiem labojumu.</string>
    <string name="apptour51__cta_try">Izmēģināt</string>
    <string name="apptour51__continue_to">Turpināt uz {version}</string>
    <string name="apptour51__intro_eyebrow">Versija 5.1</string>
    <string name="apptour51__intro_title">Jaunumi 5.1 versijā</string>
    <string name="apptour51__intro_body">Kopš 5.0 Dictate ir daudz audzis. Lūk, svarīgākais 5.1 versijā — pieskaries «Izmēģināt» jebkurā lapā, lai uzreiz pārietu uz attiecīgo funkciju.</string>
    <string name="apptour51__history_eyebrow">Transkripcija</string>
    <string name="apptour51__history_title">Transkripciju vēsture</string>
    <string name="apptour51__history_body">Katra diktēšana tagad tiek saglabāta meklējamā vēsturē. Ar vienu pieskārienu atkārtoti ievieto jebkuru iepriekšēju transkriptu, atskaņo oriģinālo audio, transkribē to no jauna vai piespraud tos, ko izmanto visbiežāk. Atsevišķs ekrāns ļauj pārvaldīt visu, tostarp to, cik ilgi tiek saglabāti audio ieraksti.</string>
    <string name="apptour51__longform_eyebrow">Transkripcija</string>
    <string name="apptour51__longform_title">Garā diktēšana</string>
    <string name="apptour51__longform_body">Runā tik ilgi, cik vēlies. Garie ieraksti tiek automātiski sadalīti segmentos un transkribēti fonā, kamēr tu turpini runāt, tāpēc tekstu saņem ātrāk un nekad nesaskaries ar garuma ierobežojumu. Sadali segmentu pats vai ļauj Dictate atpazīt dabiskās pauzes.</string>
    <string name="apptour51__gif_eyebrow">Tastatūra</string>
    <string name="apptour51__gif_title">GIF meklēšana</string>
    <string name="apptour51__gif_body">Atrodi un nosūti GIF, nemaz nepametot Dictate. Atver GIF paneli, meklē jebko un ievieto to tieši savā sarakstē — ātrs, Gboard stila atlasītājs iebūvēts turpat.</string>
    <string name="apptour51__classic_eyebrow">Klasiskais izkārtojums</string>
    <string name="apptour51__classic_title">Klasiskais izkārtojums, pārstrādāts</string>
    <string name="apptour51__classic_body">Diktēšanas ekrāns bez tastatūras ir būtiski uzlabots: brīvi izkārtojama darbību rinda, ko veido ar vilkšanu un nomešanu, garās diktēšanas vadīklas, viena vai divas uzvedņu rindas, vienmēr pieejama atpakaļatkāpe, rakstzīmju uznirstošais logs uz Enter taustiņa un neobligāta otra poga «pārslēgt tastatūru» ērtākai lietošanai ar vienu roku.</string>
    <string name="apptour51__search_eyebrow">Iestatījumi</string>
    <string name="apptour51__search_title">Meklē iestatījumos</string>
    <string name="apptour51__search_body">Neatceries, kur atrodas kāda opcija? Vienkārši meklē to. Jaunā iestatījumu meklēšana atrod jebkuru iestatījumu pēc nosaukuma, uzreiz pārlec uz to un īsi izceļ rindu — vairs nav jārok cauri izvēlnēm.</string>
    <string name="apptour51__models_eyebrow">Modeļi un pakalpojumi</string>
    <string name="apptour51__models_title">Vācu bezsaistes modelis un Claude</string>
    <string name="apptour51__models_body">Divi papildinājumi tam, kā tiek apstrādāta tava runa: vācu valodai specializēts ierīcē izpildāms modelis (Parakeet German no primeline), kas transkribē pilnībā bezsaistē tavā tālrunī, un Anthropic Claude pievienojas kā jauns pakalpojums diktāta pārfrāzēšanai un formatēšanai.</string>
    <string name="apptour51__more_eyebrow">Un vēl vairāk</string>
    <string name="apptour51__more_title">Vēl daudz uzlabojumu</string>
    <string name="apptour51__more_body">Arī daudz mazāku uzlabojumu: iestatījumos izvēlies aktīvo transkripcijas valodu, apturēšanas poga tagad patiešām atceļ notiekošu pieprasījumu, API atslēgu rādīšanas/slēpšanas slēdzis un daudzvalodu rakstīšana bez starpvalodu automātiskās labošanas — kā arī daudz labojumu klasiskajā izkārtojumā, ciparu blokā un citur.</string>
    <string name="apptour51__outro_eyebrow">Tā ir 5.1</string>
    <string name="apptour51__outro_title">Izbaudi atjauninājumu</string>
    <string name="apptour51__outro_body">Paldies, ka izmanto Dictate! Ja tas tev palīdz katru dienu, neliels ziedojums palīdz projektam turpināties. Jebkuru no šīm tūrēm vari apskatīt jebkurā laikā sadaļā Iestatījumi › Par.</string>
    <string name="apptour52__cta_try">Izmēģināt</string>
    <string name="apptour52__intro_eyebrow">Dictate 5.2</string>
    <string name="apptour52__intro_title">Diktē jebkur</string>
    <string name="apptour52__intro_body">Šis laidiens paved Dictate ārpus tās pašas tastatūras: kā tālruņa balss ievadi, mutiskām komandām no jebkuras vietas un garu diktātu sakārtošanai. Lūk, kas jauns.</string>
    <string name="apptour52__voiceinput_eyebrow">Sistēmas balss ievade</string>
    <string name="apptour52__voiceinput_title">Dictate no jebkuras tastatūras</string>
    <string name="apptour52__voiceinput_body">Dictate tagad reģistrējas kā sistēmas balss ievade: citu tastatūru un lietotņu mikrofona taustiņš transkribē caur Dictate — ar tavu pakalpojumu sniedzēju, taviem uzvednēm un taviem vietējiem modeļiem. Ieslēdz „Dictate balss ievade“ tastatūru sarakstā un izvēlies to kā balss ievades metodi. (Gboard tur mikrofonu piesaistītu Google — izmanto tastatūru, kas ievēro sistēmas iestatījumu.)</string>
    <string name="apptour52__liveprompt_eyebrow">Brīva balss komanda</string>
    <string name="apptour52__liveprompt_title">Pasaki MI, kas jādara — jebkur</string>
    <string name="apptour52__liveprompt_body">Turi peldošo pogu, lai atvērtu izvēlni, pieskaries „Live prompt“ un vienkārši pasaki, ko vēlies: „uzraksti pieklājīgu atteikumu rītdienas sapulcei“, „iztulko augšā esošo tekstu spāņu valodā“. Atlasītais teksts kalpo par kontekstu; bez atlases MI raksta no nulles.</string>
    <string name="apptour52__ondevice_eyebrow">Bezsaistē pēc pieprasījuma</string>
    <string name="apptour52__ondevice_title">Turi sūtīšanu vietējam modelim</string>
    <string name="apptour52__ondevice_body">Vai diktātam jāpaliek ierīcē? Ieraksta laikā turi sūtīšanas pogu — transkribēs tavs lejupielādētais modelis, nevis mākonis, nemainot pakalpojumu sniedzēju. To ieslēdz vietējā modeļa logā, kas tagad ir saraksta augšgalā.</string>
    <string name="apptour52__trim_eyebrow">Ātrāk un lētāk</string>
    <string name="apptour52__trim_title">Garās pauzes tiek apgrieztas</string>
    <string name="apptour52__trim_body">Aizdomājies teikuma vidū? Klusums, kas ilgāks par pāris sekundēm, tagad tiek izgriezts pirms nosūtīšanas — katrs izrunātais vārds paliek, pazūd tikai tukšais laiks. Īsāka augšupielāde nozīmē mazāk gaidīšanas un zemākas izmaksas.</string>
    <string name="apptour52__paragraphs_eyebrow">Lasāmi gari diktāti</string>
    <string name="apptour52__paragraphs_title">Automātiskas rindkopas</string>
    <string name="apptour52__paragraphs_body">Gari diktāti vairs nenonāk kā viena teksta siena. Iestati vārdu skaitu, un Dictate sāks jaunu rindkopu nākamajās teikuma beigās — deterministiski un tikai tīriem pārrakstiem, nekad MI formatētam tekstam.</string>
    <string name="apptour52__smartturn_eyebrow">Gudrāks garais režīms</string>
    <string name="apptour52__smartturn_title">Griež pie pabeigtām domām</string>
    <string name="apptour52__smartturn_body">Garā diktēšana tagad var izmantot vietējo Smart Turn v3 modeli, lai saprastu, kad tu tiešām esi pabeidzis domu, nevis grieztu pie katras pauzes. Neobligāti un lejupielādē pēc vajadzības.</string>
    <string name="apptour52__orb_eyebrow">Jauns izskats</string>
    <string name="apptour52__orb_title">Mākoņa lode</string>
    <string name="apptour52__orb_body">Ceturtais peldošās pogas izskats: mīksts mākonis, kas aug un virpuļo līdzi tavai balsij un rāda katru posmu — klausās, domā, gatavs. Izvēlas peldošās pogas iestatījumos.</string>
    <string name="apptour52__outro_eyebrow">Tā ir 5.2</string>
    <string name="apptour52__outro_title">Veiksmīgu diktēšanu</string>
    <string name="apptour52__outro_body">Turklāt daudz zem pārsega: ekrāns paliek ieslēgts visu diktātu, vietējie modeļi dīkstāvē atbrīvo atmiņu, pulksteņa diktāti pārdzīvo savienojuma pārrāvumus, un vācu automātiskā labošana tagad pārzina umlautus. Katru ekskursiju vari pārskatīt sadaļā Iestatījumi › Par.</string>
    <string name="apptour53__cta_try">Izmēģināt</string>
    <string name="apptour53__intro_eyebrow">Dictate 5.3</string>
    <string name="apptour53__intro_title">Turi, runā, gatavs</string>
    <string name="apptour53__intro_body">Šis laidiens ir par divām lietām, ko dari visbiežāk: runā ar telefonu un raksti uz tā. Abas kļuvušas ātrākas, un abas labāk paliek nost no ceļa.</string>
    <string name="apptour53__pushtotalk_eyebrow">Nospied un runā</string>
    <string name="apptour53__pushtotalk_title">Turi mikrofonu, atlaid, lai nosūtītu</string>
    <string name="apptour53__pushtotalk_body">Kā balss ziņa: turi mikrofona taustiņu un runā, atlaid — un tas aiziet. Pavelc pa kreisi, lai ierakstu izmestu, vai velc uz augšu, lai to nofiksētu un atbrīvotu roku. Īss pieskāriens darbojas kā līdz šim. Ieslēdzams Dictate iestatījumos.</string>
    <string name="apptour53__autocorrect_eyebrow">No jauna uzbūvēta labošana</string>
    <string name="apptour53__autocorrect_title">Tā lasa tavus pirkstus, nevis tavas kļūdas</string>
    <string name="apptour53__autocorrect_body">Labojumi tagad izriet no tā, kur tu patiesībā skāri taustiņus, rakstīšanas gaitā pārmeklējot ticamos vārdus, nevis minot pēc pabeigta vārda. Mūsu testu kopā precizitāte pieauga no 88 % līdz 98 % — atšķirība visvairāk redzama, rakstot ātri un pavirši.</string>
    <string name="apptour53__offline_eyebrow">Bezsaistē, tiešraidē</string>
    <string name="apptour53__offline_title">Vārdi parādās, kamēr runā — bez savienojuma</string>
    <string name="apptour53__offline_body">Ierīces modeļi tagad atšifrē jau runāšanas laikā, nevis tikai beigās, desmit valodās. Un klāt nākuši divi jauni: Canary aptver angļu, vācu, franču un spāņu valodu trešdaļā vietas, bet GigaAM specializējas krievu valodā.</string>
    <string name="apptour53__languages_eyebrow">Vēl 45 valodas</string>
    <string name="apptour53__languages_title">Horvātu, bengāļu, svahili un vēl 42</string>
    <string name="apptour53__languages_body">Valodu sarakstā bija robi, kam nebija sakara ar to, ko pakalpojumu sniedzēji patiesībā atbalsta. Tagad tas balstās uz viņu īstajām spējām — ja tava valoda trūka, paskaties vēlreiz.</string>
    <string name="apptour53__designs_eyebrow">Divi jauni izskati</string>
    <string name="apptour53__designs_title">Aurora un Lattice</string>
    <string name="apptour53__designs_body">Divi jauni peldošās pogas noformējumi, dzīvi, nevis zīmēti: gaisma, kas kustas lodes iekšpusē, un lode no punktiem, kas pati savienojas, viļņojas līdzi tavai balsij un apstrādes laikā griežas. Abi seko tavai akcenta krāsai.</string>
    <string name="apptour53__prediction_eyebrow">Mazāk taustiņsitienu</string>
    <string name="apptour53__prediction_title">Nākamais vārds, pirms tu to uzraksti</string>
    <string name="apptour53__prediction_body">Ieteikumu josla tagad piedāvā to, kas parasti seko, — mācoties no tā, kā raksti tu. Un jebkuru vārdu var pievienot vārdnīcai ar ilgu pieskārienu, lai tavi vārdi un žargons vairs netiktu laboti.</string>
    <string name="apptour53__ownserver_eyebrow">Tavs paša serveris</string>
    <string name="apptour53__ownserver_title">Pašmitināts, tagad arī tiešraidē</string>
    <string name="apptour53__ownserver_body">Tavs serveris var uzņemties arī tiešraides atšifrēšanu, ja runā OpenAI realtime protokolu. Un ja tam priekšā ir mašīna, kas guļ, Dictate to var pamodināt laikus, lai pirmais pieprasījums negaidītu tās startu.</string>
    <string name="apptour53__outro_eyebrow">Tā ir 5.3</string>
    <string name="apptour53__outro_title">Veiksmīgu diktēšanu</string>
    <string name="apptour53__outro_body">Un vēl daudz sīkumu: katram pakalpojumu sniedzējam ir savs logotips, ieraksta indikators var būt nekustīgs, pulsējošs vai balsij atsaucīgs, uzvednes izvade var blakus paturēt sākotnējo atšifrējumu, un rindkopas vairs nelūzt aiz saīsinājumiem. Katru ekskursiju vari pārskatīt sadaļā Iestatījumi › Par.</string>

    <string name="apptour60__cta_try">Izmēģināt</string>
    <string name="apptour60__art_minutes">minūtes</string>
    <string name="apptour60__art_speed">1,5×</string>
    <string name="apptour60__intro_eyebrow">Dictate 6.0</string>
    <string name="apptour60__intro_title">Kredīts, ķīniešu valoda, lētāka diktēšana</string>
    <string name="apptour60__intro_body">Šī versija pievieno otru ceļu iekšā — nopirkt kredītu, nevis izmantot savu API atslēgu —, kā arī pinjinu ķīniešu valodai, septiņas valodas ar jaunu vārdnīcu un ierakstus, kas maksā mazāk.</string>
    <string name="apptour60__speedup_eyebrow">Mazāki API izdevumi</string>
    <string name="apptour60__speedup_title">Tie paši vārdi, mazāk minūšu</string>
    <string name="apptour60__speedup_body">Ierakstus var paātrināt pirms augšupielādes, un balss nekļūst augstāka. Vairums pakalpojumu sniedzēju maksu aprēķina pēc garuma: par trešdaļu īsāks ieraksts maksā par trešdaļu mazāk. Garie diktāti turklāt tiek saspiesti, nevis noraidīti.</string>
    <string name="apptour60__chinese_eyebrow">Jaunums: pinjins</string>
    <string name="apptour60__chinese_title">Rakstiet ķīniski tā, kā to raksta</string>
    <string name="apptour60__chinese_body">Pinjins ar kandidātu rindu — līdz šim bija tikai Zhengma, ko gandrīz neviens neizmanto. Klāt nākuši ierīcē darbināms modelis, kas patiešām apmācīts ķīniešu valodā, un pakalpojumu sniedzējs, kas sasniedzams no kontinentālās Ķīnas.</string>
    <string name="apptour60__emoji_eyebrow">Emocijzīmes</string>
    <string name="apptour60__emoji_title">Meklējiet emocijzīmes savā valodā</string>
    <string name="apptour60__emoji_body">Emocijzīmju meklēšana zināja sešas valodas. Tagad to ir vairāk nekā četrdesmit — meklējiet „heart", „心" vai „قلب" un nonāksiet pie tās pašas emocijzīmes. Meklēšana seko jūsu tastatūras valodai.</string>
    <string name="apptour60__languages_eyebrow">Vārdnīcas</string>
    <string name="apptour60__languages_title">Septiņas valodas bez ieteikumiem</string>
    <string name="apptour60__languages_body">Arābu, bengāļu, somu, hindi, indonēziešu, tamilu un urdu valoda tagad saņem vārdu ieteikumus un automātisko labošanu. Islandiešu un gruzīnu vārdnīcās vienkārši bija nepareizās valodas, un tās uzbūvētas no jauna. Un 19 izkārtojumu ilgās nospiešanas rakstzīmes tagad atbilst tam, ko attiecīgajā valodā tiešām raksta.</string>
    <string name="apptour60__more_eyebrow">Turklāt</string>
    <string name="apptour60__more_title">Daudz sīkumu</string>
    <string name="apptour60__more_body">Apturēšanas pogas turēšana atsauc iestrēgušu atšifrējumu. Peldošā poga vairs nepaziņo par panākumu, ko nav spējusi pārbaudīt, un nodziest kopā ar ekrānu. Vilkšanas rakstīšana tagad zina jūsu pašu pievienotos vārdus. Un avārija tūlīt pēc atjaunināšanas ir novērsta.</string>
    <string name="apptour60__outro_eyebrow">Tā ir 6.0</string>
    <string name="apptour60__outro_title">Lai patīk</string>
    <string name="apptour60__outro_body">Lai kā jūs lietotu Dictate — sava atslēga, savs serveris, modelis ierīcē vai kredīts —, pārējos ceļos nekas nav mainījies. Katru ievadu varat pārskatīt sadaļā Iestatījumi › Par.</string>
    <string name="apptour61__cta_try">Izmēģināt</string>
    <string name="apptour61__art_folder">Uzlīmes</string>
    <string name="apptour61__art_share">Kopīgot ar</string>
    <string name="apptour61__art_typed">tsa</string>
    <string name="apptour61__art_fixed">tas</string>
    <string name="apptour61__intro_eyebrow">Dictate 6.1</string>
    <string name="apptour61__intro_title">Uzlīmes, balss ziņas un automātiskā labošana, kas beidzot pamana drukas kļūdu</string>
    <string name="apptour61__intro_body">Norādi tastatūrai mapi ar savām uzlīmēm, kopīgo balss ziņu tieši ar Dictate, lai uzzinātu, kas tajā teikts, un izmanto automātisko labošanu, kas beidzot pamana kļūdu, kuru tā bija būvēta nepamanīt.</string>
    <string name="apptour61__stickers_eyebrow">Jauns: tavas paša uzlīmes</string>
    <string name="apptour61__stickers_title">Mape telefonā — uz tastatūras</string>
    <string name="apptour61__stickers_body">Norādi Dictate jebkuru mapi, un tajā esošie attēli kļūst par uzlīmēm — apakšmapes pārvēršas cilnēs ar savām izlasēm un nesen lietotajām. Pievieno no jebkuras lietotnes, izmantojot kopīgošanas izvēlni, dzēs, nepametot tastatūru. Tas, ko tērzēšanas lietotne patiešām pieņem, nav tas, ko tā apgalvo pieņemam: tāpēc katra uzlīme tiek sagatavota vienreiz, to pievienojot, un no turienes vienkārši nosūtīta.</string>
    <string name="apptour61__share_eyebrow">Jauns: kopīgot ar Dictate</string>
    <string name="apptour61__share_title">Uzzini, ko saka šī balss ziņa</string>
    <string name="apptour61__share_body">Dictate tagad ir audio un video kopīgošanas izvēlnē. Kopīgo tur balss ziņu, un atveras ekrāns, kas pats sāk atšifrēt — nav jāmeklē lauks un nav jāspiež poga. Atšifrējumā var meklēt, bet gari ieraksti tiek apstrādāti pa daļām, nevis noraidīti.</string>
    <string name="apptour61__autocorrect_eyebrow">Automātiskā labošana</string>
    <string name="apptour61__autocorrect_title">Drukas kļūda, ko tā nespēja saskatīt</string>
    <string name="apptour61__autocorrect_body">Noteikums, kas izlēma, vai vārdu drīkst labot, laida cauri pirkstu, kas bija noslīdējis gandrīz līdz blakus taustiņam, bet nekad tādu, kas uz tā nolaidās precīzi — lai gan tieši tā ir parastā drukas kļūda. Tas ir izlabots, un cik izlēmīgi tiek labots, tagad nosaki tu pats. Vārds, ko paņems atstarpes taustiņš, ir atzīmēts ar tavu akcenta krāsu, un atpakaļatkāpes taustiņš uzreiz pēc tam atdod tieši to, ko biji ierakstījis.</string>
    <string name="apptour61__contacts_eyebrow">Kontakti</string>
    <string name="apptour61__contacts_title">Vārdi, kas vairs netiek pasvītroti</string>
    <string name="apptour61__contacts_body">Tavu kontaktu vārdi var nonākt personiskajā vārdnīcā, lai tastatūra pārstātu tos uzskatīt par kļūdām un sāktu piedāvāt. Piekļuve adrešu grāmatai netiek prasīta — vārdus izvēlies pats vai importē vCard. Netiek nolasīts nekas, ko neesi nodevis.</string>
    <string name="apptour61__models_eyebrow">Gemini un Deepgram Flux</string>
    <string name="apptour61__models_title">Divi pakalpojumi, kas iemācījušies klausīties labāk</string>
    <string name="apptour61__models_body">Google izlaida savus runas atpazīšanas modeļus, tāpēc Gemini vairs neatšifrē ar tērzēšanas modeli pēc norādījuma — un tagad to prot arī tiešraidē. Deepgram Flux pats izlemj, kad esi beidzis runāt, nevis nogaida klusumu. Un, ja runā vairākās valodās, tagad vari pateikt, kurās, nevis izvēlēties vienu un cerēt.</string>
    <string name="apptour61__more_eyebrow">Turklāt</string>
    <string name="apptour61__more_title">Daudz sīkumu</string>
    <string name="apptour61__more_body">Sagataves var izsaukt, ierakstot saīsinājumu, ne tikai pieskaroties. Krievu valodu var rakstīt fonētiski, bet franču valoda atrod savas diakritiskās zīmes pēc kailiem burtiem. Ļoti platām planšetēm ainavas režīmā atkal ir tastatūra. Un ieteikumu slēdzis tos tiešām izslēdz — arī tad, kad lietotne to grib izdarīt tavā vietā.</string>
    <string name="apptour61__outro_eyebrow">Tā ir 6.1</string>
    <string name="apptour61__outro_title">Tā pati tastatūra, ar mazāk asām malām</string>
    <string name="apptour61__outro_body">Nekas nemainās tajā, kā tu diktē līdz šim — savs atslēgas kods, savs serveris vai modelis ierīcē. Visas pamācības atkal atrodamas sadaļā Iestatījumi › Par.</string>
    <string name="changelog__v5_0_0">• JAUNS: Vilkšanas rakstīšana — velc pār taustiņiem, lai rakstītu veselus vārdus, ar valodu vārdnīcām, kas tiek lejupielādētas pēc pieprasījuma. 👆\n• JAUNS: Vārdu ieteikumi un automātiskā labošana — drukas kļūdas tiek labotas automātiski, un ierakstītais vārds paliek viena pieskāriena attālumā. ✨\n• JAUNS: Reāllaika transkripcija — vēro, kā vārdi parādās, kamēr runā, ar OpenAI, Deepgram, Soniox, AssemblyAI un ElevenLabs. ⚡\n• JAUNS: Vēl trīs transkripcijas pakalpojumi — ElevenLabs Scribe, Deepgram un AssemblyAI. ☁️\n• JAUNS: Klasiskais diktēšanas izkārtojums — Dictate 3 balss ekrāns bez tastatūras ir atpakaļ, fiksēts vai viena vilkuma attālumā. 🎙️\n• JAUNS: Kopienas uzvednu bibliotēka — pārlūko un kopīgo pārformulēšanas uzvednes. 📚\n• JAUNS: Diktēšanas statistika ar atskaites punktiem. 📊\n• JAUNS: Bezsaistes modelis NVIDIA Parakeet, kā arī klusuma filtrs, kas izlaiž tukšos ierakstus. 📴\n• Vēl: stabilāka peldošā poga, spriešanas piepūles vadība, taktilā atsauce, jauna E-Reader tēma un desmitiem labojumu. 🛠️</string>
