    <string name="dictate__haptic_feedback_summary">Vibra all\'avvio e all\'arresto della registrazione, quando la trascrizione è pronta e alla riscrittura.</string>
    <string name="dictate__audio_source_voice_communication">Comunicazione vocale</string>
