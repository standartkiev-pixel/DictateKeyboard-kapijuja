    <string name="dictate__haptic_feedback_title">Wibracje</string>
    <string name="dictate__haptic_feedback_summary">Wibruje przy starcie/stopie nagrywania, gdy transkrypcja jest gotowa i przy przeredagowaniu.</string>
    <string name="dictate__audio_source_voice_communication">Komunikacja głosowa</string>
    <string name="dictate__audio_source_voice_communication_summary">Najwyższy priorytet mikrofonu — działa, gdy inna aplikacja używa mikrofonu, ale może obniżyć dokładność.</string>
    <string name="about__whats_new__title">Nowości</string>
    <string name="about__whats_new__versioned">Nowości w {version}</string>
    <string name="about__whats_new__summary">Zobacz przewodnik po funkcjach ponownie</string>
    <string name="apptour__skip">Pomiń</string>
    <string name="apptour__next">Dalej</string>
    <string name="apptour__start">Zaczynajmy</string>
    <string name="apptour__done">Gotowe</string>
    <string name="apptour__badge_highlight">★ Wyróżnione</string>
    <string name="apptour__intro_eyebrow">Version 5.0</string>
    <string name="apptour__intro_title">Szybki przewodnik</string>
    <string name="apptour__intro_body">Oto nowości w Dictate 5.0 — najważniejsze punkty w mniej niż minutę. Dotknij „Wypróbuj” na dowolnej stronie, aby przejść prosto do danego ustawienia.</string>
    <string name="apptour__glide_eyebrow">Klawiatura</string>
    <string name="apptour__glide_title">Przesuwaj, aby pisać</string>
    <string name="apptour__glide_body">Przesuwaj palcem od klawisza do klawisza, a Dictate zamieni tę ścieżkę w całe słowa. Każdy język ma własny słownik pobierany na żądanie — włącz go w sekcji Gesty.</string>
    <string name="apptour__glide_cta">Skonfiguruj pisanie gestami</string>
    <string name="apptour__suggestions_eyebrow">Klawiatura</string>
    <string name="apptour__suggestions_title">Autokorekta i podpowiedzi</string>
    <string name="apptour__suggestions_body">Podczas pisania Dictate proponuje pasujące słowa i po cichu poprawia literówki. Słowo, które faktycznie wpisałeś, zostaje na pasku podpowiedzi, więc jedno dotknięcie cofa każdą poprawkę.</string>
    <string name="apptour__suggestions_cta">Dostosuj podpowiedzi</string>
    <string name="apptour__realtime_eyebrow">Transkrypcja</string>
    <string name="apptour__realtime_title">Transkrypcja na żywo</string>
    <string name="apptour__realtime_body">Obserwuj, jak Twoje słowa pojawiają się na żywo, gdy jeszcze mówisz, zamiast czekać na koniec nagrania. Działa z OpenAI, Deepgram, Soniox, AssemblyAI i ElevenLabs.</string>
    <string name="apptour__realtime_cta">Włącz tryb na żywo</string>
    <string name="apptour__providers_eyebrow">Transkrypcja</string>
    <string name="apptour__providers_title">Trzej nowi dostawcy w chmurze</string>
    <string name="apptour__providers_body">ElevenLabs Scribe, Deepgram i AssemblyAI dołączają do usług transkrypcji — wybierz tę, która najlepiej pasuje do Twojego języka, dokładności, szybkości i budżetu.</string>
    <string name="apptour__providers_cta">Wybierz dostawcę</string>
    <string name="apptour__legacy_eyebrow">Powrót klasyka</string>
    <string name="apptour__legacy_title">Klasyczny układ dyktowania</string>
    <string name="apptour__legacy_body">Wolisz głos od klawiszy? Ekran bez klawiatury z Dictate 3 powraca — ustaw go jako domyślny albo trzymaj o jedno przesunięcie od pełnej klawiatury.</string>
    <string name="apptour__legacy_cta">Wybierz układ</string>
    <string name="apptour__library_eyebrow">Społeczność</string>
    <string name="apptour__library_title">Biblioteka promptów</string>
    <string name="apptour__library_body">Przeglądaj polecenia przeredagowania udostępniane przez społeczność i instaluj je jednym dotknięciem — albo opublikuj własne, by inni mogli z nich korzystać.</string>
    <string name="apptour__library_cta">Otwórz bibliotekę</string>
    <string name="apptour__stats_eyebrow">Statystyki</string>
    <string name="apptour__stats_title">Twoje statystyki dyktowania</string>
    <string name="apptour__stats_body">Śledź, ile podyktowałeś i napisałeś w czasie, zdobywaj kamienie milowe i zobacz krótkie podsumowanie wprost na ekranie głównym.</string>
    <string name="apptour__stats_cta">Zobacz statystyki</string>
    <string name="apptour__offline_eyebrow">Bez chmury</string>
    <string name="apptour__offline_title">Transkrybuj offline</string>
    <string name="apptour__offline_body">Uruchom model NVIDIA Parakeet w całości na telefonie — bez internetu, nic nie opuszcza urządzenia. Filtr ciszy pomija też puste nagrania, więc nigdy nie dostaniesz przypadkowego tekstu.</string>
    <string name="apptour__offline_cta">Pobierz model offline</string>
    <string name="apptour__outro_eyebrow">I więcej</string>
    <string name="apptour__outro_title">Dopracowane wszędzie</string>
    <string name="apptour__outro_body">Więcej pod maską: stabilniejszy pływający przycisk, regulacja wysiłku rozumowania przy przeredagowaniu, wibracje, nowy motyw E-Reader i dziesiątki poprawek.</string>
    <string name="apptour51__cta_try">Wypróbuj</string>
    <string name="apptour51__continue_to">Przejdź do {version}</string>
    <string name="apptour51__intro_eyebrow">Version 5.1</string>
    <string name="apptour51__intro_title">Nowości w 5.1</string>
    <string name="apptour51__intro_body">Dictate mocno się rozwinął od wersji 5.0. Oto najważniejsze nowości 5.1 — dotknij „Wypróbuj” na dowolnej stronie, aby przejść prosto do danej funkcji.</string>
    <string name="apptour51__history_eyebrow">Transkrypcja</string>
    <string name="apptour51__history_title">Historia transkrypcji</string>
    <string name="apptour51__history_body">Każde dyktowanie jest teraz zapisywane w przeszukiwanej historii. Wstaw ponownie dowolną wcześniejszą transkrypcję jednym dotknięciem, odtwórz oryginalne audio, transkrybuj je ponownie lub przypnij te, których używasz najczęściej. Osobny ekran pozwala zarządzać wszystkim, w tym tym, jak długo przechowywane są nagrania audio.</string>
    <string name="apptour51__longform_eyebrow">Transkrypcja</string>
    <string name="apptour51__longform_title">Długie dyktowanie</string>
    <string name="apptour51__longform_body">Mów tak długo, jak chcesz. Długie nagrania są automatycznie dzielone na segmenty i transkrybowane w tle, gdy mówisz dalej, więc otrzymujesz tekst szybciej i nigdy nie napotkasz limitu długości. Przetnij segment samodzielnie albo pozwól, by Dictate wykrył naturalne pauzy.</string>
    <string name="apptour51__gif_eyebrow">Klawiatura</string>
    <string name="apptour51__gif_title">Wyszukiwanie GIF</string>
    <string name="apptour51__gif_body">Znajduj i wysyłaj GIF-y bez opuszczania Dictate. Otwórz panel GIF, wyszukaj cokolwiek i wrzuć to prosto do czatu — szybki selektor w stylu Gboard, wbudowany na miejscu.</string>
    <string name="apptour51__classic_eyebrow">Klasyczny układ</string>
    <string name="apptour51__classic_title">Klasyczny układ, przeprojektowany</string>
    <string name="apptour51__classic_body">Ekran dyktowania bez klawiatury zyskał dużą aktualizację: dowolnie układany pasek akcji budowany metodą przeciągnij i upuść, sterowanie długimi nagraniami, jeden lub dwa wiersze promptów, zawsze dostępny backspace, wyskakujące znaki na klawiszu Enter oraz opcjonalny drugi przycisk „zmień klawiaturę” dla wygodniejszej obsługi jedną ręką.</string>
    <string name="apptour51__search_eyebrow">Ustawienia</string>
    <string name="apptour51__search_title">Przeszukaj ustawienia</string>
    <string name="apptour51__search_body">Nie pamiętasz, gdzie jest dana opcja? Po prostu ją wyszukaj. Nowa wyszukiwarka ustawień znajduje dowolne ustawienie po nazwie, przechodzi prosto do niego i na chwilę podświetla wiersz — koniec z grzebaniem w menu.</string>
    <string name="apptour51__models_eyebrow">Modele &amp; dostawcy</string>
    <string name="apptour51__models_title">Niemiecki model offline &amp; Claude</string>
    <string name="apptour51__models_body">Dwa dodatki dotyczące przetwarzania mowy: wyspecjalizowany w niemieckim model na urządzeniu (Parakeet German od primeline), który transkrybuje całkowicie offline na telefonie, oraz Claude firmy Anthropic dołącza jako nowy dostawca do przeredagowywania i formatowania dyktowań.</string>
    <string name="apptour51__more_eyebrow">I więcej</string>
    <string name="apptour51__more_title">Wiele innych ulepszeń</string>
    <string name="apptour51__more_body">Także mnóstwo mniejszych ulepszeń: wybierz aktywny język transkrypcji w ustawieniach, przycisk stop naprawdę anuluje trwające żądanie, przełącznik pokaż/ukryj dla kluczy API oraz pisanie wielojęzyczne bez autokorekty między językami — plus wiele poprawek w klasycznym układzie, klawiaturze numerycznej i nie tylko.</string>
    <string name="apptour51__outro_eyebrow">Oto 5.1</string>
    <string name="apptour51__outro_title">Miłego korzystania z aktualizacji</string>
    <string name="apptour51__outro_body">Dziękujemy za korzystanie z Dictate! Jeśli pomaga Ci każdego dnia, drobna darowizna pomaga utrzymać projekt. Każdy z tych przewodników możesz w każdej chwili obejrzeć ponownie w Ustawienia › Informacje.</string>
    <string name="apptour52__cta_try">Wypróbuj</string>
    <string name="apptour52__intro_eyebrow">Dictate 5.2</string>
    <string name="apptour52__intro_title">Dyktuj wszędzie</string>
    <string name="apptour52__intro_body">Ta wersja wyprowadza Dictate poza własną klawiaturę: jako wprowadzanie głosowe telefonu, do wypowiadanych poleceń z dowolnego miejsca i do porządkowania długich dyktand. Oto nowości.</string>
    <string name="apptour52__voiceinput_eyebrow">Systemowe wprowadzanie głosowe</string>
    <string name="apptour52__voiceinput_title">Dictate z dowolnej klawiatury</string>
    <string name="apptour52__voiceinput_body">Dictate rejestruje się teraz jako systemowe wprowadzanie głosowe: przycisk mikrofonu w innych klawiaturach i aplikacjach transkrybuje przez Dictate — z Twoim dostawcą, Twoimi promptami i Twoimi modelami lokalnymi. Włącz „Wprowadzanie głosowe Dictate” na liście klawiatur i wybierz je jako metodę wprowadzania głosowego. (Gboard wiąże mikrofon z Google — użyj klawiatury, która respektuje ustawienie systemowe.)</string>
    <string name="apptour52__liveprompt_eyebrow">Swobodne polecenie głosowe</string>
    <string name="apptour52__liveprompt_title">Powiedz SI, co ma zrobić — wszędzie</string>
    <string name="apptour52__liveprompt_body">Przytrzymaj pływający przycisk, aby otworzyć menu, dotknij „Live prompt” i po prostu powiedz, czego chcesz: „napisz uprzejmą odmowę na jutrzejsze spotkanie”, „przetłumacz powyższy tekst na hiszpański”. Zaznaczony tekst służy jako kontekst; bez zaznaczenia SI pisze od zera.</string>
    <string name="apptour52__ondevice_eyebrow">Offline na życzenie</string>
    <string name="apptour52__ondevice_title">Przytrzymaj wyślij dla modelu lokalnego</string>
    <string name="apptour52__ondevice_body">Chcesz, aby dyktando zostało na urządzeniu? Przytrzymaj przycisk wysyłania podczas nagrywania, a transkrypcję wykona pobrany model zamiast chmury — bez zmiany dostawcy. Włącz to w oknie modelu lokalnego, które jest teraz na górze listy dostawców.</string>
    <string name="apptour52__trim_eyebrow">Szybciej i taniej</string>
    <string name="apptour52__trim_title">Długie pauzy są wycinane</string>
    <string name="apptour52__trim_body">Zamyśliłeś się w połowie zdania? Ciszę dłuższą niż kilka sekund wycinamy przed wysłaniem — każde wypowiedziane słowo zostaje, znika tylko martwy czas. Krótsze przesyłanie to mniej czekania i niższy koszt.</string>
    <string name="apptour52__paragraphs_eyebrow">Czytelne długie dyktanda</string>
    <string name="apptour52__paragraphs_title">Automatyczne akapity</string>
    <string name="apptour52__paragraphs_body">Długie dyktanda nie przychodzą już jako ściana tekstu. Ustaw liczbę słów, a Dictate rozpocznie nowy akapit na następnym końcu zdania — deterministycznie i tylko dla czystych transkrypcji, nigdy dla tekstu sformatowanego przez SI.</string>
    <string name="apptour52__smartturn_eyebrow">Mądrzejszy tryb długi</string>
    <string name="apptour52__smartturn_title">Tnie na zakończonych myślach</string>
    <string name="apptour52__smartturn_body">Dyktowanie długich tekstów może teraz używać lokalnego modelu Smart Turn v3, aby rozpoznać, kiedy naprawdę skończyłeś myśl, zamiast ciąć przy każdej pauzie. Opcjonalne i pobierane na żądanie.</string>
    <string name="apptour52__orb_eyebrow">Nowy wygląd</string>
    <string name="apptour52__orb_title">Chmurowa kula</string>
    <string name="apptour52__orb_body">Czwarta skórka pływającego przycisku: miękka chmura, która rośnie i wiruje wraz z Twoim głosem i pokazuje każdy etap — słucham, myślę, gotowe. Wybierz ją w ustawieniach pływającego przycisku.</string>
    <string name="apptour52__outro_eyebrow">To jest 5.2</string>
    <string name="apptour52__outro_title">Udanego dyktowania</string>
    <string name="apptour52__outro_body">Do tego sporo pod maską: ekran pozostaje włączony przez całe dyktowanie, modele lokalne zwalniają pamięć w bezczynności, dyktanda z zegarka przetrwają zerwanie połączenia, a niemiecka autokorekta radzi sobie z umlautami. Każdy przewodnik obejrzysz ponownie w Ustawieniach › Informacje.</string>
    <string name="apptour53__cta_try">Wypróbuj</string>
    <string name="apptour53__intro_eyebrow">Dictate 5.3</string>
    <string name="apptour53__intro_title">Przytrzymaj, mów, gotowe</string>
    <string name="apptour53__intro_body">Ta wersja dotyczy dwóch rzeczy, które robisz najczęściej: mówienia do telefonu i pisania na nim. Obie są szybsze i obie lepiej schodzą ci z drogi.</string>
    <string name="apptour53__pushtotalk_eyebrow">Naciśnij i mów</string>
    <string name="apptour53__pushtotalk_title">Przytrzymaj mikrofon, puść, by wysłać</string>
    <string name="apptour53__pushtotalk_body">Jak wiadomość głosowa: przytrzymaj klawisz mikrofonu i mów, puść i leci. Przesuń w lewo, by wyrzucić nagranie, albo przeciągnij w górę, by je zablokować i uwolnić rękę. Krótkie dotknięcie działa jak dotąd. Włączysz to w ustawieniach Dictate.</string>
    <string name="apptour53__autocorrect_eyebrow">Autokorekta zbudowana od nowa</string>
    <string name="apptour53__autocorrect_title">Czyta twoje palce, nie twoje literówki</string>
    <string name="apptour53__autocorrect_body">Poprawki powstają teraz z tego, gdzie naprawdę dotknąłeś klawiszy — z przeszukiwaniem prawdopodobnych słów na bieżąco, zamiast zgadywania z gotowego wyrazu. Na naszym zestawie testowym skuteczność wzrosła z 88 % do 98 %. Różnicę widać zwłaszcza przy szybkim, niechlujnym pisaniu.</string>
    <string name="apptour53__offline_eyebrow">Offline, na żywo</string>
    <string name="apptour53__offline_title">Słowa pojawiają się w trakcie mówienia — bez połączenia</string>
    <string name="apptour53__offline_body">Modele na urządzeniu transkrybują teraz już podczas mówienia, a nie dopiero na końcu, w dziesięciu językach. Doszły też dwa nowe: Canary obejmuje angielski, niemiecki, francuski i hiszpański w jednej trzeciej miejsca, a GigaAM specjalizuje się w rosyjskim.</string>
    <string name="apptour53__languages_eyebrow">45 języków więcej</string>
    <string name="apptour53__languages_title">Chorwacki, bengalski, suahili i 42 inne</string>
    <string name="apptour53__languages_body">Lista języków miała luki niemające związku z tym, co dostawcy naprawdę obsługują. Teraz opiera się na ich rzeczywistych możliwościach — jeśli twojego języka brakowało, zajrzyj ponownie.</string>
    <string name="apptour53__designs_eyebrow">Dwa nowe wyglądy</string>
    <string name="apptour53__designs_title">Aurora i Lattice</string>
    <string name="apptour53__designs_body">Dwa nowe wzory pływającego przycisku, żywe zamiast narysowanych: światło poruszające się w kuli oraz kula z punktów, która sama się łączy, faluje z twoim głosem i obraca się podczas pracy. Oba trzymają się twojego koloru akcentu.</string>
    <string name="apptour53__prediction_eyebrow">Mniej stuknięć</string>
    <string name="apptour53__prediction_title">Następne słowo, zanim je napiszesz</string>
    <string name="apptour53__prediction_body">Pasek podpowiedzi proponuje teraz to, co zwykle następuje dalej — nauczone z twojego sposobu pisania. A każde słowo dodasz do słownika długim przytrzymaniem, żeby nazwy i żargon przestały być poprawiane.</string>
    <string name="apptour53__ownserver_eyebrow">Twój własny serwer</string>
    <string name="apptour53__ownserver_title">Self-hosted, teraz także na żywo</string>
    <string name="apptour53__ownserver_body">Twój własny serwer może teraz obsłużyć również transkrypcję na żywo, o ile mówi protokołem realtime OpenAI. A jeśli stoi przed maszyną, która śpi, Dictate potrafi obudzić ją wcześniej, by pierwsze żądanie nie czekało na rozruch.</string>
    <string name="apptour53__outro_eyebrow">Oto 5.3</string>
    <string name="apptour53__outro_title">Udanego dyktowania</string>
    <string name="apptour53__outro_body">Do tego wiele drobiazgów: każdy dostawca ma własne logo, wskaźnik nagrywania może być nieruchomy, pulsujący albo reagujący na głos, wynik promptu może zachować obok oryginalną transkrypcję, a akapity nie łamią się już po skrótach. Każdy przewodnik obejrzysz ponownie w Ustawieniach › Informacje.</string>

    <string name="apptour60__cta_try">Wypróbuj</string>
    <string name="apptour60__art_minutes">minut</string>
    <string name="apptour60__art_speed">1,5×</string>
    <string name="apptour60__intro_eyebrow">Dictate 6.0</string>
    <string name="apptour60__intro_title">Doładowanie, chiński, tańsze dyktowanie</string>
    <string name="apptour60__intro_body">Ta wersja dodaje drugą drogę wejścia — kupno doładowania zamiast własnego klucza API — a do tego pinyin dla chińskiego, siedem języków z nowym słownikiem i nagrania, które kosztują mniej.</string>
    <string name="apptour60__speedup_eyebrow">Mniejsze koszty API</string>
    <string name="apptour60__speedup_title">Te same słowa, mniej minut</string>
    <string name="apptour60__speedup_body">Nagrania można przyspieszyć przed wysłaniem, bez podnoszenia tonu głosu. Większość dostawców liczy według długości nagrania: krótsze o jedną trzecią kosztuje o jedną trzecią mniej. Długie dyktanda są ponadto pakowane, zamiast być odrzucane.</string>
    <string name="apptour60__chinese_eyebrow">Nowość: pinyin</string>
    <string name="apptour60__chinese_title">Pisz po chińsku tak, jak się pisze</string>
    <string name="apptour60__chinese_body">Pinyin z wierszem kandydatów — dotąd był tylko Zhengma, z którego prawie nikt nie korzysta. Do tego model na urządzeniu naprawdę uczony na chińskim i dostawca osiągalny z Chin kontynentalnych.</string>
    <string name="apptour60__emoji_eyebrow">Emoji</string>
    <string name="apptour60__emoji_title">Szukaj emoji w swoim języku</string>
    <string name="apptour60__emoji_body">Wyszukiwarka emoji znała sześć języków. Teraz zna ponad czterdzieści — poszukaj „heart", „心" lub „قلب" i trafisz na to samo emoji. Wyszukiwanie podąża za językiem klawiatury.</string>
    <string name="apptour60__languages_eyebrow">Słowniki</string>
    <string name="apptour60__languages_title">Siedem języków bez podpowiedzi</string>
    <string name="apptour60__languages_body">Arabski, bengalski, fiński, hindi, indonezyjski, tamilski i urdu dostają podpowiedzi słów i autokorektę. Islandzki i gruziński zawierały po prostu niewłaściwe języki i zostały zbudowane od nowa. A znaki spod długiego przytrzymania w 19 układach odpowiadają teraz temu, co dany język faktycznie zapisuje.</string>
    <string name="apptour60__more_eyebrow">Ponadto</string>
    <string name="apptour60__more_title">Wiele drobiazgów</string>
    <string name="apptour60__more_body">Przytrzymanie przycisku stop wycofuje zawieszoną transkrypcję. Pływający przycisk nie zgłasza już sukcesu, którego nie mógł sprawdzić, i gaśnie razem z ekranem. Pisanie gestem zna teraz dodane przez ciebie słowa. Naprawiono też awarię zaraz po aktualizacji.</string>
    <string name="apptour60__outro_eyebrow">Oto 6.0</string>
    <string name="apptour60__outro_title">Miłego korzystania</string>
    <string name="apptour60__outro_body">Niezależnie od tego, jak używasz Dictate — własny klucz, własny serwer, model na urządzeniu czy doładowanie — w pozostałych drogach nic się nie zmieniło. Każdy przewodnik obejrzysz ponownie w Ustawienia › Informacje.</string>
    <string name="apptour61__cta_try">Wypróbuj</string>
    <string name="apptour61__art_folder">Naklejki</string>
    <string name="apptour61__art_share">Udostępnij przez</string>
    <string name="apptour61__art_typed">nei</string>
    <string name="apptour61__art_fixed">nie</string>
    <string name="apptour61__intro_eyebrow">Dictate 6.1</string>
    <string name="apptour61__intro_title">Naklejki, wiadomości głosowe i autokorekta, która wreszcie widzi literówkę</string>
    <string name="apptour61__intro_body">Wskaż klawiaturze folder z własnymi naklejkami, udostępnij wiadomość głosową prosto do Dictate, żeby dowiedzieć się, co w niej jest, i korzystaj z autokorekty, która wreszcie zauważa błąd, którego z założenia nie widziała.</string>
    <string name="apptour61__stickers_eyebrow">Nowość: własne naklejki</string>
    <string name="apptour61__stickers_title">Folder w telefonie, na klawiaturze</string>
    <string name="apptour61__stickers_body">Wskaż Dictate dowolny folder, a jego obrazy staną się naklejkami — podfoldery zamieniają się w zakładki, z własnymi ulubionymi i ostatnio używanymi. Dodawaj z każdej aplikacji przez menu udostępniania, usuwaj bez opuszczania klawiatury. To, co komunikator naprawdę przyjmuje, nie jest tym, co deklaruje: dlatego każda naklejka jest raz doprowadzana do właściwej postaci przy dodawaniu i stamtąd po prostu wysyłana.</string>
    <string name="apptour61__share_eyebrow">Nowość: udostępnij do Dictate</string>
    <string name="apptour61__share_title">Dowiedz się, co mówi ta wiadomość głosowa</string>
    <string name="apptour61__share_body">Dictate pojawia się teraz w menu udostępniania dla dźwięku i wideo. Udostępnij tam wiadomość głosową, a otworzy się ekran, który sam zaczyna transkrypcję — nie trzeba szukać pola ani naciskać przycisku. Transkrypcję można przeszukiwać, a długie nagrania są dzielone na części zamiast odrzucane.</string>
    <string name="apptour61__autocorrect_eyebrow">Autokorekta</string>
    <string name="apptour61__autocorrect_title">Literówka, której nie mogła zobaczyć</string>
    <string name="apptour61__autocorrect_body">Reguła decydująca, czy słowo można poprawić, przepuszczała palec, który zsunął się prawie do sąsiedniego klawisza, ale nigdy takiego, który trafił w niego czysto — a to właśnie zwykła literówka. To zostało naprawione, a stanowczość poprawiania ustawiasz teraz sam. Słowo, które weźmie spacja, jest oznaczone twoim kolorem akcentu, a Backspace zaraz potem zwraca dokładnie to, co napisałeś.</string>
    <string name="apptour61__contacts_eyebrow">Kontakty</string>
    <string name="apptour61__contacts_title">Imiona, których już nie podkreśla</string>
    <string name="apptour61__contacts_body">Imiona twoich kontaktów mogą trafić do słownika osobistego, żeby klawiatura przestała brać je za literówki i zaczęła je podpowiadać. Nie prosi przy tym o dostęp do książki adresowej — sam wybierasz imiona albo importujesz vCard. Nie jest odczytywane nic, czego sam nie przekazałeś.</string>
    <string name="apptour61__models_eyebrow">Gemini i Deepgram Flux</string>
    <string name="apptour61__models_title">Dwaj dostawcy, którzy nauczyli się lepiej słuchać</string>
    <string name="apptour61__models_body">Google wydał własne modele zamiany mowy na tekst, więc Gemini nie transkrybuje już modelem czatowym z instrukcją — i potrafi to teraz również na żywo. Flux od Deepgram sam decyduje, kiedy skończyłeś mówić, zamiast odczekiwać ciszę. A jeśli mówisz kilkoma językami, możesz teraz powiedzieć którymi, zamiast wybierać jeden i liczyć na szczęście.</string>
    <string name="apptour61__more_eyebrow">Ponadto</string>
    <string name="apptour61__more_title">Wiele drobiazgów</string>
    <string name="apptour61__more_body">Szablony można wywołać, wpisując skrót, nie tylko dotykając ich. Rosyjski da się pisać fonetycznie, a francuski odnajduje akcenty na podstawie samych liter. Bardzo szerokie tablety znów mają klawiaturę w poziomie. A przełącznik podpowiedzi naprawdę je wyłącza — również wtedy, gdy aplikacja chce zrobić to za ciebie.</string>
    <string name="apptour61__outro_eyebrow">To jest 6.1</string>
    <string name="apptour61__outro_title">Ta sama klawiatura, mniej ostrych krawędzi</string>
    <string name="apptour61__outro_body">Nic się nie zmienia w tym, jak dyktujesz do tej pory — własny klucz, własny serwer albo model na urządzeniu. Wszystkie przewodniki znajdziesz ponownie w Ustawienia › O aplikacji.</string>
    <string name="changelog__v5_0_0">• NOWOŚĆ: Pisanie gestami — przesuwaj po klawiszach, aby pisać całe słowa, ze słownikami dla poszczególnych języków pobieranymi na żądanie. 👆\n• NOWOŚĆ: Podpowiedzi słów i autokorekta — literówki są poprawiane automatycznie, a wpisane słowo pozostaje o jedno dotknięcie. ✨\n• NOWOŚĆ: Transkrypcja na żywo — patrz, jak słowa pojawiają się, gdy mówisz, z OpenAI, Deepgram, Soniox, AssemblyAI i ElevenLabs. ⚡\n• NOWOŚĆ: Trzej kolejni dostawcy transkrypcji — ElevenLabs Scribe, Deepgram i AssemblyAI. ☁️\n• NOWOŚĆ: Klasyczny układ dyktowania — pozbawiony klawiatury ekran głosowy z Dictate 3 wraca, zablokowany lub o jedno przesunięcie. 🎙️\n• NOWOŚĆ: Biblioteka promptów społeczności — przeglądaj i udostępniaj prompty do przeredagowania. 📚\n• NOWOŚĆ: Statystyki dyktowania z kamieniami milowymi. 📊\n• NOWOŚĆ: Model offline NVIDIA Parakeet oraz filtr ciszy pomijający puste nagrania. 📴\n• Więcej: stabilniejszy pływający przycisk, regulacja wysiłku rozumowania, wibracje haptyczne, nowy motyw E-Reader i dziesiątki poprawek. 🛠️</string>
    <string name="media__tab__gifs">GIFs</string>
    <string name="prefs__media__gif__title">GIFs</string>
    <string name="prefs__media__gif_enabled">Włącz wyszukiwanie GIFs</string>
    <string name="prefs__media__gif_enabled__summary">Wyszukuj i wstawiaj GIFs dzięki KLIPY</string>
    <string name="prefs__media__gif_setup__title">Konfiguracja wyszukiwania GIFs</string>
    <string name="prefs__media__gif_setup__summary_set">Klucz API KLIPY zapisany</string>
    <string name="prefs__media__gif_setup__summary_unset">Dotknij, aby dodać swój darmowy klucz API KLIPY</string>
    <string name="prefs__media__gif_setup__intro">GIFs są dostarczane przez KLIPY, darmową usługę. Potrzebujesz tylko własnego darmowego klucza — zajmie to tylko chwilę:</string>
    <string name="prefs__media__gif_setup__step1">Otwórz Panel Partnera KLIPY — jeśli nie masz konta, zostaniesz poproszony o jego bezpłatne utworzenie.</string>
    <string name="prefs__media__gif_setup__step2">Na stronie Klucze API utwórz klucz API.</string>
    <string name="prefs__media__gif_setup__step3">Skopiuj klucz i wklej go w pole poniżej.</string>
    <string name="prefs__media__gif_setup__open_klipy">Otwórz Panel Partnera KLIPY</string>
    <string name="prefs__media__gif_setup__key_label">Klucz API KLIPY</string>
    <string name="prefs__media__gif_setup__privacy_note">Twoje wyszukiwane hasła są wysyłane do KLIPY tylko wtedy, gdy panel GIFs jest otwarty — nigdy podczas dyktowania.</string>
    <string name="gif__search_placeholder">Szukaj w KLIPY</string>
