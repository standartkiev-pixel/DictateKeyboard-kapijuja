    <!-- Default example prompts seeded on a fresh install. A useful starter set covering all three
         prompt types: rewrite-the-selection editors, free generators and literal [snippets]. Resolved
         from string resources so they are localized at seed time. -->
    <!-- Rewrite-the-selection prompts (operate on the highlighted / dictated text). -->
    <string name="dictate__example_prompt_fix_grammar_name">Fix Grammar</string>
    <string name="dictate__example_prompt_fix_grammar_prompt">Correct all spelling, grammar and punctuation mistakes in the text. Keep the original wording, tone and language as much as possible and do not add new information. Return only the corrected text, without quotation marks or explanations.</string>
    <string name="dictate__example_prompt_improve_name">Improve Writing</string>
    <string name="dictate__example_prompt_improve_prompt">Rewrite the text so it reads more clearly and flows better, while keeping its meaning, tone and language. Do not add new information. Return only the improved text, without quotation marks or explanations.</string>
    <string name="dictate__example_prompt_formal_name">Make Formal</string>
    <string name="dictate__example_prompt_formal_prompt">Rewrite the text in a polite, professional and formal tone. Keep its meaning and language and add no new information. Return only the rewritten text, without quotation marks or explanations.</string>
    <string name="dictate__example_prompt_friendly_name">Make Friendly</string>
    <string name="dictate__example_prompt_friendly_prompt">Rewrite the text in a warm, friendly and casual tone. Keep its meaning and language and add no new information. Return only the rewritten text, without quotation marks or explanations.</string>
    <string name="dictate__example_prompt_shorter_name">Make Shorter</string>
    <string name="dictate__example_prompt_shorter_prompt">Make the text noticeably shorter and more concise while keeping all important information, its tone and its language. Return only the shortened text, without quotation marks or explanations.</string>
    <string name="dictate__example_prompt_translate_name">Translate to English</string>
    <string name="dictate__example_prompt_translate_prompt">Translate the text into natural, fluent English. Keep the original meaning and tone. Return only the translation, without quotation marks or explanations.</string>
